# ── Server ──────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Storage ─────────────────────────────────────────────
# "true"  = keep torrent pieces in RAM only (needs the optional
#           memory-chunk-store package, npm i memory-chunk-store).
#           Zero SSD writes, but capped by available memory.
# "false" = write pieces to CACHE_DIR on disk instead.
USE_MEMORY_STORE=true
CACHE_DIR=temp_cache
HISTORY_FILE=history.json

# ── Idle cleanup ────────────────────────────────────────
# How long (ms) a torrent can sit un-streamed before it is
# torn down automatically. Does NOT apply while paused.
IDLE_TIMEOUT_MS=240000
IDLE_CHECK_INTERVAL_MS=5000

# ── Streaming ───────────────────────────────────────────
# Size (bytes) of the look-ahead window downloaded per
# range request. 4 MiB by default.
PIECE_WINDOW_BYTES=4194304

# ── VLC ─────────────────────────────────────────────────
# Leave blank to auto-detect (default install path on
# Windows, `open -a VLC` on macOS, `vlc` on PATH on Linux).
VLC_PATH=
